# Example environment for docker run --env-file. Copy to worker.env and fill in.
AOQ_WP_URL=https://wordpress.example.com
AOQ_WP_USER=aoq-worker
AOQ_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
AOQ_AO_URL=https://ao.example.internal:8765
# Worker-hosted search (D14). SearXNG with the JSON format enabled.
AOQ_SEARXNG_URL=https://search.example.internal
# Identify the worker to Wikimedia and others; include a contact URL or email.
AOQ_HTTP_USER_AGENT=ao-quill-worker/0.1.0 (+https://www.example.org/contact)
# AOQ_WP_CA_FILE=/path/to/wordpress-ca.pem   (only when running outside a container)
# AOQ_AO_MTLS_DIR=/path/to/mtls               (cert.pem, key.pem, ca.pem; outside a container)
# AOQ_AO_HEADERS_JSON={"Authorization": "Bearer REPLACE_ME"}
