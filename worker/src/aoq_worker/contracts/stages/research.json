{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/research",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^s[0-9]{1,3}$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https?://"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "source_id",
          "url",
          "title"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^c[0-9]{1,3}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_id": {
            "type": "string",
            "pattern": "^s[0-9]{1,3}$"
          },
          "supporting_quote": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        },
        "required": [
          "claim",
          "supporting_quote"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 80
    }
  },
  "required": [
    "claims"
  ],
  "additionalProperties": false
}
