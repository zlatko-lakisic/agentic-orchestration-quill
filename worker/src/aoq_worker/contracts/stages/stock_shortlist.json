{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/stock_shortlist",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image_id": {
            "type": "string",
            "pattern": "^(openverse:[A-Za-z0-9-]{1,64}|commons:[0-9]{1,15})$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "image_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    }
  },
  "required": [
    "candidates"
  ],
  "additionalProperties": false
}
