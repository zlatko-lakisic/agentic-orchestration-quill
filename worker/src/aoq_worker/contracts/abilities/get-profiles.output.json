{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aoq/get-profiles.output",
  "type": "object",
  "properties": {
    "site_profile": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "fingerprint": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$"
          },
          "maxItems": 100000
        },
        "built_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "fingerprint",
        "built_at",
        "data"
      ],
      "additionalProperties": false
    },
    "style_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "fingerprint": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+:[0-9]+$"
            },
            "maxItems": 100000
          },
          "built_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "language",
          "fingerprint",
          "built_at",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "borrowed_style": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "saved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string",
                "pattern": "^[a-z]{2,3}$"
              },
              "data": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "language",
              "data"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": [
        "source",
        "saved_at",
        "profiles"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "site_profile",
    "style_profiles"
  ],
  "additionalProperties": false
}
