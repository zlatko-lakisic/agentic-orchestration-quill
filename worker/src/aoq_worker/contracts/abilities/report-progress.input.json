{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aoq/report-progress.input",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "label": {
      "type": "string",
      "maxLength": 200
    },
    "output": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "maxLength": 64
          },
          "task": {
            "type": "string",
            "maxLength": 200
          },
          "agent": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "task",
          "agent",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "heartbeat": {
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "step",
    "steps",
    "label",
    "output"
  ],
  "additionalProperties": false
}
