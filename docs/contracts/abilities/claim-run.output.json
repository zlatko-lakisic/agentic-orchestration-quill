{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aoq/claim-run.output",
  "type": "object",
  "properties": {
    "run": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "scheduled",
            "manual",
            "test"
          ]
        },
        "lease_expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "resume": {
          "type": "object",
          "properties": {
            "resumed_from": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "from_step": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "state": {
              "type": "string",
              "minLength": 2,
              "maxLength": 8000000
            }
          },
          "required": [
            "resumed_from",
            "from_step",
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "run_date",
        "trigger",
        "lease_expires_at"
      ],
      "additionalProperties": false
    },
    "instagram": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "test",
            "post"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2000
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "job_id",
        "mode",
        "language",
        "title",
        "excerpt",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "run"
  ],
  "additionalProperties": false
}
