{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aoq/save-profiles.input",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "site_profile": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "fingerprint": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$"
          },
          "maxItems": 100000
        },
        "built_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "fingerprint",
        "built_at",
        "data"
      ],
      "additionalProperties": false
    },
    "style_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "fingerprint": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+:[0-9]+$"
            },
            "maxItems": 100000
          },
          "built_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "language",
          "fingerprint",
          "built_at",
          "data"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "site_profile",
    "style_profiles"
  ],
  "additionalProperties": false
}
