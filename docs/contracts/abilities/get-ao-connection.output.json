{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aoq/get-ao-connection.output",
  "type": "object",
  "properties": {
    "ao_url": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "ao_ipv4_only": {
      "type": "boolean"
    },
    "searxng_url": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://"
    },
    "user_agent": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300
    },
    "mtls": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "cert_pem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "-----BEGIN CERTIFICATE-----"
        },
        "key_pem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
        },
        "ca_pem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "-----BEGIN CERTIFICATE-----"
        }
      },
      "required": [
        "cert_pem",
        "key_pem",
        "ca_pem"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ao_url",
    "ao_ipv4_only",
    "searxng_url",
    "user_agent",
    "mtls"
  ],
  "additionalProperties": false
}
