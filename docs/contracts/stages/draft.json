{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/draft",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9-]+$"
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "seo_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "seo_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "focus_keyword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "content_html": {
      "type": "string",
      "minLength": 200,
      "maxLength": 200000
    }
  },
  "required": [
    "title",
    "slug",
    "excerpt",
    "seo_title",
    "seo_description",
    "focus_keyword",
    "content_html"
  ],
  "additionalProperties": false
}
