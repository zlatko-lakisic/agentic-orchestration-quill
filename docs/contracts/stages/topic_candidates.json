{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/topic_candidates",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^t[0-9]{1,2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "angle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "target_category_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "maxItems": 5
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^https?://"
                },
                "title": {
                  "type": "string",
                  "maxLength": 300
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "url",
                "title",
                "note"
              ],
              "additionalProperties": false
            },
            "maxItems": 10
          }
        },
        "required": [
          "title",
          "angle"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 10
    }
  },
  "required": [
    "candidates"
  ],
  "additionalProperties": false
}
