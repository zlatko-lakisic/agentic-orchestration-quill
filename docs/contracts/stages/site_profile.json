{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/site_profile",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "minItems": 1,
      "maxItems": 40
    },
    "content_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 40
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 40
    }
  },
  "required": [
    "summary",
    "audience",
    "themes",
    "content_gaps",
    "avoid"
  ],
  "additionalProperties": false
}
