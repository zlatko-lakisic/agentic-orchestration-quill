{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/translation",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slug": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9-]*$"
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "seo_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "seo_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "focus_keyword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "content_html": {
      "type": "string",
      "minLength": 200,
      "maxLength": 200000
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(featured|inline-[0-9]+)$"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "caption": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "key",
          "alt",
          "caption"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 7
    }
  },
  "required": [
    "language",
    "title",
    "slug",
    "excerpt",
    "seo_title",
    "seo_description",
    "focus_keyword",
    "content_html",
    "images"
  ],
  "additionalProperties": false
}
