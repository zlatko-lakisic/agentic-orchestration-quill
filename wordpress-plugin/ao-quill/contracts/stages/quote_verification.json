{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/quote_verification",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https?://"
          },
          "fetched": {
            "type": "boolean"
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 999
          },
          "chars": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "source_id",
          "url",
          "fetched",
          "http_status",
          "chars",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "verified": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "claim_id",
          "verified",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sources",
    "claims"
  ],
  "additionalProperties": false
}
