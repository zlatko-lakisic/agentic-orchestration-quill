{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stage/text_checks",
  "type": "object",
  "properties": {
    "structure": {
      "type": "object",
      "properties": {
        "title_chars": {
          "type": "integer",
          "minimum": 0
        },
        "seo_title_chars": {
          "type": "integer",
          "minimum": 0
        },
        "seo_description_chars": {
          "type": "integer",
          "minimum": 0
        },
        "h1_count": {
          "type": "integer",
          "minimum": 0
        },
        "heading_order_ok": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "title_chars",
        "seo_title_chars",
        "seo_description_chars",
        "h1_count",
        "heading_order_ok",
        "problems",
        "score"
      ],
      "additionalProperties": false
    },
    "originality": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "max_overlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "worst_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "references_checked": {
          "type": "integer",
          "minimum": 0
        },
        "fetch_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "n",
        "max_overlap",
        "worst_reference",
        "references_checked",
        "fetch_errors",
        "score"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "structure",
    "originality"
  ],
  "additionalProperties": false
}
