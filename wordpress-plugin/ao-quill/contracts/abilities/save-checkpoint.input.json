{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aoq/save-checkpoint.input",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 40
    },
    "state": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8000000
    }
  },
  "required": [
    "run_id",
    "step",
    "completed",
    "state"
  ],
  "additionalProperties": false
}
