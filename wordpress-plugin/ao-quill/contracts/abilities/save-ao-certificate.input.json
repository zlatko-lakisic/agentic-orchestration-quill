{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aoq/save-ao-certificate.input",
  "type": "object",
  "properties": {
    "cert_pem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "-----BEGIN CERTIFICATE-----"
    },
    "key_pem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    "ca_pem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "-----BEGIN CERTIFICATE-----"
    }
  },
  "required": [
    "cert_pem",
    "key_pem",
    "ca_pem"
  ],
  "additionalProperties": false
}
